%** New command definitions

%* --[ Environments ----------------------------------------------------------

% boostovalbox definition
\definecolor{boostballblue}{HTML}{009EE0}% blue of Boost "it" ball
\newlength{\boostovalboxwidth}

\newenvironment{boostovalbox}[1][]{
    \setlength{\boostovalboxwidth}{\linewidth}
    % Remove 2x inner sep from the width
    \addtolength{\boostovalboxwidth}{-10pt}
\begin{tikzpicture}[boostovalboxstyle/.append style={rectangle,rounded corners=5pt,inner sep=5pt,inner ysep=5pt}]
    \if@black
        \tikzset{boostovalboxstyle/.append style={draw}}
    \else
        \tikzset{boostovalboxstyle/.append style={fill=boostballblue!30!white}}
    \fi
    \node [boostovalboxstyle] (box) \bgroup
    \begin{minipage}{\boostovalboxwidth}
        \ifstrempty{#1}{}{\textbf{#1~--- }}%
        }{
    \end{minipage}
    \egroup;
\end{tikzpicture}
\newline{}
}

% Redefine the shaded environment in order to:
% - have a frame around the environment (use \fcolorbox instead of \colorbox);
% - add some space between the text and the frame.
% Also define a default framecolor color.
\definecolor{framecolor}{named}{black}
\renewenvironment{shaded}{%
\def\FrameCommand{\fboxsep=3pt \fcolorbox{framecolor}{shadecolor}}%
\MakeFramed {\FrameRestore}}%
{\endMakeFramed}

