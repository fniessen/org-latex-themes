\newcounter{boostcomment}
\newcommand{\boostcomment}[2][]{% initials of the author + note in the margin
\if@boostcomment
    \refstepcounter{boostcomment}
    {\setstretch{0.7}% spacing
    \todo[color={red!100!green!33},size=\small]{%
    \textbf{Comment [\uppercase{#1}\theboostcomment]:}~#2}}
\else
    \relax
\fi
}

% This is to be compared with boostcomment. Certainly not as good.
\newcommand{\fixxme}[1]{%%
  \textcolor{red}{FIXXME}\marginpar{\textcolor{red}{#1}}%%
}

\newcommand{\boosttodo}[2][]{% title in bold + note
\refstepcounter{boostcomment}
{\todo[inline,color=blue!20]{
% \ifthenelse{\equal{{#1}}{}}
% {}%
% {\textbf{#1}~}%
\textbf{TODO [\uppercase{#1}\theboostcomment]:}~#2}}}

